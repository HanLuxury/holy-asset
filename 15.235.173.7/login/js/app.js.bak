// ================= CEF SYSTEM =================
window.cef = {
    events: {},

    on: function(name, callback) {
        this.events[name] = callback;
    },

    emit: function(name, ...args) {
        if (this.events[name]) {
            this.events[name](...args);
        }
    }
};

// ================= NOTIF =================
cef.on("data:not", (title, text) => {
    addNotif(title, text);
});

function addNotif(title, text) {
    let container = document.getElementById("notifContainer");

    let div = document.createElement("div");
    div.className = "notif";

    div.innerHTML = "<b>" + title + "</b><br>" + text;

    container.prepend(div);

    setTimeout(() => div.remove(), 5000);
}
function addnot(heads, seconds) {

    // 🔊 PLAY SOUND
    let sound = document.getElementById("notifSound");
    if (sound) {
        sound.currentTime = 0;
        sound.play().catch(() => {});
    }

    let div = document.createElement('div');
    div.className = "background";

    let icon = document.createElement('div');
    icon.className = "icon";

    let img = document.createElement('img');
    img.src = "https://img.icons8.com/color/48/ok--v1.png";

    icon.append(img);
    div.append(icon);

    let wrap = document.createElement('div');
    wrap.className = "text-wrap";

    let a1 = document.createElement('div');
    a1.className = "text-head";
    a1.innerHTML = heads;

    let p2 = document.createElement('div');
    p2.className = "text-second";
    p2.innerHTML = seconds;

    wrap.append(a1);
    wrap.append(p2);

    div.append(wrap);

    document.getElementById('append').append(div);
}
// ================= PHONE =================
cef.on("phone:toggle", () => {
    let phone = document.getElementById("phone");

    if (phone.classList.contains("hidden")) {
        phone.classList.remove("hidden");
    } else {
        phone.classList.add("hidden");
    }
});

// ================= TEST =================
function testNotif() {
    addNotif("TEST", "INI DARI HTML 🔥");
}